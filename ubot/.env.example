# Salin file ini menjadi ".env" (di folder yang sama dengan bot.js), isi nilainya, lalu restart bot.
# Alternatif: isi di config.json -> "gateway": { "api_key": "...", "secret": "..." }

# AGW / SMP Payment (pembayaran QRIS Beli Role / Up Role / Produk / .qris) - key agw_live_... dan secret agw_sec_... dari admin gateway
AGW_KEY=
AGW_SECRET=

# AustinPay (Otomatis 2) - opsional, biasanya diisi lewat Panel Owner > Mode QRIS
AUSTIN_KEY=
AUSTIN_SECRET=

# Channel notifikasi (bot harus jadi admin channel), contoh -1001234567890
NOTIFY_CHANNEL_ID=
